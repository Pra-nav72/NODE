<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>sign up</title>
</head>
<body>
    <main class="items-center text-center bg-cyan-700 h-[80vh] w-[30vw] rounded-2xl shadow-2xl mx-auto my-7 px-4 py-2 text-white">
        <h1 class="text-3xl">Sign up</h1>
        <form action="/user/signup" method="post" class="text-black my-10">
            <input type="text" name="username" placeholder="username" required class="bg-white px-2 py-0.5 min-w-[25vw] my-2">
            <input type="email" name="email" placeholder="xyz@abc.com" required class="bg-white px-2 py-0.5 min-w-[25vw] my-2">
            <div class="px-2 py-0.5 my-2">
                <input type="radio"  name="gender" value="male" class="size-6"> 
                <span class="px-2 text-3xl text-red-500">male</span>
                <input type="radio"  name="gender" value="female" class="size-6">
                <span class="px-2 text-3xl text-orange-500">female</span>
                <input type="radio"  name="gender" value="other" class="size-6">
                <span class="px-2 text-3xl text-yellow-300">other</span>
            </div>
            <input type="password" name="password" placeholder="password" class="bg-white px-2 py-0.5 min-w-[25vw] my-2">
            <input type="submit" value="sign up" class="rounded-2xl bg-green-800 text-white px-4 py-2 my-5">
        </form>
        <span><i>already have account,  </i></span><a href="/user/signin" class="text-yellow-300">sign in</a>
    </main>
</body>
</html>