<nav class="bg-gray-900 text-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <div class="shrink-0">
        <a href="/" class="text-2xl font-bold text-blue-400">
            All-Blogs
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a
          href="/"
          class="text-white hover:text-blue-400 transition duration-300"
        >
          Home
        </a>

        <a
          href="/about"
          class="text-gray-300 hover:text-blue-400 transition duration-300"
        >
          About
        </a>

        <a
          href="/services"
          class="text-gray-300 hover:text-blue-400 transition duration-300"
        >
          Services
        </a>

        <a
          href="/contact"
          class="text-gray-300 hover:text-blue-400 transition duration-300"
        >
          Contact
        </a>
      </div>

     <!-- User Avatar Dropdown -->
<div class="relative hidden md:block group">

    <!-- Avatar Button -->
    <button
        type="button"
        class="flex items-center gap-2 rounded-full
               p-1
               hover:bg-white/10
               transition-all duration-200
               focus:outline-none"
    >
        <img
            src="<%= user.profileImageURL %>"
            alt="<%= user.username %>"
            class="w-10 h-10 rounded-full object-cover
                   border-2 border-cyan-400
                   shadow-lg shadow-cyan-500/20
                   transition-transform duration-200
                   group-hover:scale-105"
        >

        <!-- Down arrow -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-gray-300
                   transition-transform duration-200
                   group-hover:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
            />
        </svg>
    </button>


    <!-- Dropdown -->
    <div
        class="absolute right-0 top-full mt-3
               w-52
               bg-slate-900
               border border-slate-700
               rounded-2xl
               shadow-2xl
               overflow-hidden

               opacity-0
               invisible
               translate-y-2

               group-hover:opacity-100
               group-hover:visible
               group-hover:translate-y-0

               transition-all duration-200
               z-50"
    >

        <!-- User Information -->
        <div class="px-4 py-3 border-b border-slate-700">

            <p class="text-white font-semibold truncate">
                <%= user.username %>
            </p>

            <p class="text-slate-400 text-xs truncate">
                <%= user.email %>
            </p>

        </div>


        <!-- Profile -->
        <a
            href="/user/profile"
            class="flex items-center gap-3
                   px-4 py-3
                   text-gray-300
                   hover:bg-slate-800
                   hover:text-white
                   transition-colors"
        >

            <!-- Profile icon -->
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-cyan-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 7a3 3 0 11-6 0 3 3 0 016 0z
                       M5 20a7 7 0 0114 0"
                />
            </svg>

            <span>Profile</span>

        </a>


        <!-- Divider -->
        <div class="border-t border-slate-700"></div>


        <!-- Logout -->
        <a
            href="/user/logOut"
            class="flex items-center gap-3
                   px-4 py-3
                   text-red-400
                   hover:bg-red-500/10
                   hover:text-red-300
                   transition-colors"
        >

            <!-- Logout icon -->
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4
                       M10 17l5-5m0 0l-5-5m5 5H3"
                />
            </svg>

            <span>Log out</span>

        </a>

    </div>

</div>

      <!-- Mobile Menu Button -->
      <button
        class="md:hidden text-gray-300 hover:text-white focus:outline-none"
      >
        ☰
      </button>

    </div>
  </div>
</nav>


