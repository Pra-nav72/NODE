<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Sign In</title>
</head>

<body class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-10">

    <!-- Background decoration -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-96 h-96
                    bg-cyan-500/20 rounded-full blur-3xl"></div>

        <div class="absolute -bottom-40 -left-40 w-96 h-96
                    bg-blue-600/20 rounded-full blur-3xl"></div>
    </div>


    <!-- Sign In Container -->
    <main class="relative w-full max-w-md">
        <%- include('./partials/alert') %>

        <div class="bg-white/10 backdrop-blur-xl
                    border border-white/10
                    rounded-3xl shadow-2xl
                    p-8 sm:p-10">


            <!-- Header -->
            <div class="text-center mb-8">

                <div class="mx-auto mb-5 w-14 h-14
                            rounded-2xl
                            bg-linear-to-br from-cyan-400 to-blue-600
                            flex items-center justify-center
                            shadow-lg shadow-cyan-500/20">

                    <!-- Login icon -->
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-7 h-7 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4
                               M10 17l5-5m0 0l-5-5m5 5H3"
                        />
                    </svg>

                </div>

                <h1 class="text-3xl font-bold text-white">
                    Welcome Back
                </h1>

                <p class="text-slate-400 mt-2 text-sm">
                    Sign in to continue to your account
                </p>

            </div>


            <!-- Form -->
            <form
                action="/user/signin"
                method="post"
                class="space-y-5"
            >

                <!-- Email -->
                <div>

                    <label
                        for="email"
                        class="block text-sm font-medium
                               text-slate-300 mb-2"
                    >
                        Email address
                    </label>

                    <div class="relative">

                        <!-- Email icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="absolute left-4 top-1/2
                                   -translate-y-1/2
                                   w-5 h-5 text-slate-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8
                                   M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5
                                   a2 2 0 00-2 2v10a2 2 0 002 2z"
                            />
                        </svg>


                        <input
                            id="email"
                            type="email"
                            name="email"
                            placeholder="you@example.com"
                            required
                            autocomplete="email"
                            class="w-full bg-slate-900/70
                                   border border-slate-700
                                   rounded-xl
                                   pl-12 pr-4 py-3
                                   text-white
                                   placeholder-slate-500
                                   outline-none
                                   transition
                                   focus:border-cyan-400
                                   focus:ring-2
                                   focus:ring-cyan-400/20"
                        >

                    </div>

                </div>


                <!-- Password -->
                <div>

                    <div class="flex items-center justify-between mb-2">

                        <label
                            for="password"
                            class="block text-sm font-medium
                                   text-slate-300"
                        >
                            Password
                        </label>

                        <a
                            href="/user/forgot-password"
                            class="text-xs text-cyan-400
                                   hover:text-cyan-300 transition"
                        >
                            Forgot password?
                        </a>

                    </div>


                    <div class="relative">

                        <!-- Lock icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="absolute left-4 top-1/2
                                   -translate-y-1/2
                                   w-5 h-5 text-slate-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 15v2m-6 4h12a2 2 0 002-2v-6
                                   a2 2 0 00-2-2H6a2 2 0 00-2 2v6
                                   a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                            />
                        </svg>


                        <input
                            id="password"
                            type="password"
                            name="password"
                            placeholder="Enter your password"
                            required
                            autocomplete="current-password"
                            class="w-full bg-slate-900/70
                                   border border-slate-700
                                   rounded-xl
                                   pl-12 pr-4 py-3
                                   text-white
                                   placeholder-slate-500
                                   outline-none
                                   transition
                                   focus:border-cyan-400
                                   focus:ring-2
                                   focus:ring-cyan-400/20"
                        >

                    </div>

                </div>


                <!-- Remember me -->
                <div class="flex items-center">

                    <label class="flex items-center gap-2
                                  cursor-pointer">

                        <input
                            type="checkbox"
                            name="remember"
                            class="w-4 h-4
                                   rounded
                                   border-slate-600
                                   bg-slate-900
                                   text-cyan-500
                                   focus:ring-cyan-500"
                        >

                        <span class="text-sm text-slate-400">
                            Remember me
                        </span>

                    </label>

                </div>


                <!-- Submit -->
                <button
                    type="submit"
                    class="w-full py-3.5
                           rounded-xl
                           bg-linear-to-r
                           from-cyan-500 to-blue-600
                           hover:from-cyan-400
                           hover:to-blue-500
                           text-white font-semibold
                           shadow-lg
                           shadow-blue-500/20
                           transition-all duration-300
                           hover:scale-[1.01]
                           active:scale-[0.99]"
                >
                    Sign In
                </button>

            </form>


            <!-- Sign Up -->
            <div class="mt-7 pt-6
                        border-t border-white/10
                        text-center">

                <p class="text-sm text-slate-400">

                    New to our platform?

                    <a
                        href="/user/signup"
                        class="text-cyan-400
                               font-semibold
                               hover:text-cyan-300
                               transition"
                    >
                        Create an account
                    </a>

                </p>

            </div>

        </div>


        <!-- Footer -->
        <p class="text-center text-xs text-slate-600 mt-5">
            Secure login · Your information is protected
        </p>

    </main>

</body>
</html>