<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>

    <title>My Profile</title>
</head>

<body class="bg-slate-950 text-white">

    <%- include('./partials/Navigation') %>


    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">


        <!-- =========================
             PROFILE HEADER
        ========================== -->

        <div class="mb-10">

            <h1 class="text-3xl sm:text-4xl font-bold text-white">
                My Profile
            </h1>

            <p class="mt-2 text-slate-400">
                Manage your profile and your blogs.
            </p>

        </div>



<!-- =========================
     PROFILE CARD
========================== -->

<section
    class="overflow-hidden
           rounded-3xl
           bg-slate-900
           border border-slate-800
           shadow-xl
           mb-16"
>

    <!-- Profile Banner -->
    <div
        class="h-32 sm:h-40
               bg-linear-to-r
               from-cyan-600/30
               via-blue-600/20
               to-purple-600/30"
    ></div>


    <!-- Profile Content -->
    <div class="px-6 sm:px-8 pb-8">

        <form
            action="/profile/edit"
            method="POST"
            enctype="multipart/form-data"
        >

            <!-- Avatar + User Details -->
            <div
                class="-mt-12
                       flex
                       items-start
                       gap-6"
            >

                <!-- =========================
                     AVATAR
                ========================== -->

                <div class="flex shrink-0 flex-col items-center gap-3">

                    <img
                        id="profilePreview"
                        src="<%= user.profileImageURL %>"
                        alt="<%= username %>"
                        class="w-24 h-24
                               sm:w-28 sm:h-28
                               rounded-2xl
                               object-cover
                               border-4
                               border-slate-900
                               shadow-xl
                               bg-slate-800"
                    >


                    <!-- Hidden File Input -->
                    <input
                        type="file"
                        id="profileImage"
                        name="profileImage"
                        accept="image/*"
                        class="hidden"
                        onchange="previewProfileImage(event)"
                    >


                    <!-- Change Profile Picture -->
                    <label
                        for="profileImage"
                        title="Change profile picture"
                        class="inline-flex
                               items-center
                               justify-center
                               gap-2
                               rounded-lg
                               bg-cyan-500
                               px-3 py-2
                               text-sm
                               font-semibold
                               text-white
                               cursor-pointer
                               shadow-lg
                               hover:bg-cyan-400
                               transition-all"
                    >

                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.862 3.487a2.25 2.25 0 113.182 3.182L7.5 19.213l-4.5 1.125 1.125-4.5L16.862 3.487z"
                            />
                        </svg>

                        Change profile picture
                    </label>

                </div>


                <!-- =========================
                     USERNAME + EMAIL
                ========================== -->

                <div
                    class="flex-1
                           space-y-5
                           pt-12"
                >

                    <!-- Username -->
                    <div>

                        <label
                            for="username"
                            class="block
                                   mb-2
                                   text-sm
                                   font-medium
                                   text-slate-300"
                        >
                            Username
                        </label>

                        <input
                            type="text"
                            id="username"
                            name="username"
                            value="<%= username %>"
                            required
                            class="w-full
                                   px-4 py-3
                                   rounded-xl
                                   bg-slate-800
                                   border border-slate-700
                                   text-white
                                   outline-none
                                   focus:border-cyan-500
                                   focus:ring-1
                                   focus:ring-cyan-500
                                   transition"
                        >

                    </div>


                    <!-- Email -->
                    <div>

                        <label
                            for="email"
                            class="block
                                   mb-2
                                   text-sm
                                   font-medium
                                   text-slate-300"
                        >
                            Email
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= user.email %>"
                            required
                            class="w-full
                                   px-4 py-3
                                   rounded-xl
                                   bg-slate-800
                                   border border-slate-700
                                   text-white
                                   outline-none
                                   focus:border-cyan-500
                                   focus:ring-1
                                   focus:ring-cyan-500
                                   transition"
                        >

                    </div>

                </div>

            </div>


            <!-- =========================
                 SAVE BUTTON
            ========================== -->

            <div
                  class="mt-8
                       pt-6
                       border-t border-slate-800
                      flex w-full justify-end"
            >

                <button
                    type="submit"
                    class="inline-flex
                           items-center
                           mb-3
                           gap-2
                           px-6 py-3
                           rounded-xl
                           bg-linear-to-r
                           from-cyan-500
                           to-blue-600
                           text-white
                           font-semibold
                           shadow-lg
                           shadow-cyan-500/10
                           hover:from-cyan-400
                           hover:to-blue-500
                           hover:-translate-y-0.5
                           transition-all"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 13l4 4L19 7"
                        />
                    </svg>

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</section>


<!-- =========================
     MY BLOGS
========================== -->

<section class="mt-8">

    <div
        class="flex flex-col
               sm:flex-row
               sm:items-center
               sm:justify-between
               gap-4
               mb-6"
    >

        <div>

            <h2 class="text-2xl sm:text-3xl font-bold text-white">
                My Blogs
            </h2>

            <p class="mt-1 text-slate-400">
                Blogs you have published.
            </p>

        </div>




    </div>

    <!-- Your existing blogs grid goes here -->
     <!-- =========================
             MY BLOGS HEADER
        ========================== -->

        <div
            class="flex flex-col sm:flex-row
                   sm:items-center
                   sm:justify-between
                   gap-4
                   mb-6 "
        >

            


            <!-- Create Blog -->
            <a
                href="/blog/add-blog"
                class="inline-flex
                       items-center
                       justify-center
                       gap-2
                       px-5 py-3
                       rounded-xl
                       bg-slate-800
                       border border-slate-700
                       text-cyan-400
                       font-semibold
                       hover:bg-slate-700
                       hover:border-cyan-500/50
                       transition"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4v16m8-8H4"
                    />
                </svg>

                Create Blog

            </a>

        </div>


        <!-- =========================
             BLOG LIST
        ========================== -->

        <% if (blogs.length > 0) { %>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                <% blogs.forEach(blog => { %>

                    <article
                        class="group
                               overflow-hidden
                               rounded-2xl
                               bg-slate-900
                               border border-slate-800
                               shadow-xl
                               hover:-translate-y-1
                               hover:border-cyan-500/40
                               transition-all duration-300"
                    >

                        <!-- Cover Image -->
                        <div class="relative h-48 overflow-hidden">

                            <img
                                src="<%= blog.coverImageURL %>"
                                alt="<%= blog.title %>"
                                class="w-full h-full
                                       object-cover
                                       group-hover:scale-105
                                       transition-transform duration-500"
                            >

                            <div
                                class="absolute inset-0
                                       bg-linear-to-t
                                       from-slate-950/80
                                       via-transparent
                                       to-transparent"
                            ></div>

                        </div>


                        <!-- Content -->
                        <div class="p-5">

                            <!-- Date -->
                            <p class="text-xs text-slate-500 mb-2">
                                <%= new Date(blog.createdAt).toLocaleDateString('en-US', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric'
                                }) %>
                            </p>


                            <!-- Title -->
                            <h3
                                class="text-xl
                                       font-bold
                                       text-white
                                       line-clamp-2
                                       group-hover:text-cyan-400
                                       transition-colors"
                            >
                                <%= blog.title %>
                            </h3>


                            <!-- Description -->
                            <p
                                class="mt-3
                                       text-sm
                                       leading-6
                                       text-slate-400
                                       line-clamp-3"
                            >
                                <%= blog.body %>
                            </p>


                            <!-- Actions -->
                            <div
                                class="mt-6
                                       flex
                                       items-center
                                       justify-between
                                       gap-3"
                            >

                                <!-- View -->
                                <a
                                    href="/blog/<%= blog._id %>"
                                    class="inline-flex
                                           items-center
                                           gap-2
                                           text-sm
                                           font-semibold
                                           text-cyan-400
                                           hover:text-cyan-300
                                           transition"
                                >

                                    View

                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-4 h-4"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13 7l5 5m0 0l-5 5m5-5H6"
                                        />
                                    </svg>

                                </a>


                                <!-- Edit + Delete -->
                                <div class="flex items-center gap-2">

                                    <!-- Edit -->
                                    <a
                                        href="/blog/edit/<%= blog._id %>"
                                        class="p-2
                                               rounded-lg
                                               bg-slate-800
                                               text-slate-300
                                               hover:bg-cyan-500/10
                                               hover:text-cyan-400
                                               transition"
                                        title="Edit blog"
                                    >

                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-5 h-5"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M16.862 3.487a2.25 2.25 0 113.182 3.182L7.5 19.213l-4.5 1.125 1.125-4.5L16.862 3.487z"
                                            />
                                        </svg>

                                    </a>


                                    <!-- Delete -->
                                    <form
                                        action="/blog/delete/<%= blog._id %>"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this blog?');"
                                    >

                                        <button
                                            type="submit"
                                            class="p-2
                                                   rounded-lg
                                                   bg-slate-800
                                                   text-slate-300
                                                   hover:bg-red-500/10
                                                   hover:text-red-400
                                                   transition"
                                            title="Delete blog"
                                        >

                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="w-5 h-5"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M6 7h12
                                                       M9 7V4h6v3
                                                       M10 11v6
                                                       M14 11v6
                                                       M5 7l1 13h12l1-13"
                                                />
                                            </svg>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>


        <% } else { %>


            <!-- =========================
                 EMPTY BLOG STATE
            ========================== -->

            <div
                class="flex
                       flex-col
                       items-center
                       justify-center
                       py-20
                       px-6
                       text-center
                       rounded-3xl
                       bg-slate-900
                       border border-slate-800"
            >

                <div
                    class="w-20 h-20
                           rounded-2xl
                           bg-slate-800
                           flex
                           items-center
                           justify-center
                           mb-6"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-10 h-10 text-slate-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M19 20H5
                               a2 2 0 01-2-2V6
                               a2 2 0 012-2h10
                               a2 2 0 012 2v1
                               m-1 13h3
                               a2 2 0 002-2V9
                               a2 2 0 00-2-2h-3
                               M9 12h6
                               M9 16h6"
                        />
                    </svg>

                </div>


                <h3 class="text-2xl font-bold text-white">
                    You haven't written anything yet
                </h3>


                <p class="mt-2 max-w-md text-slate-400">
                    Start sharing your thoughts and ideas with the community.
                </p>


                <a
                    href="/blog/add-blog"
                    class="mt-6
                           inline-flex
                           items-center
                           gap-2
                           px-6 py-3
                           rounded-xl
                           bg-linear-to-r
                           from-cyan-500
                           to-blue-600
                           text-white
                           font-semibold
                           hover:from-cyan-400
                           hover:to-blue-500
                           transition"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 4v16m8-8H4"
                        />
                    </svg>

                    Write Your First Blog

                </a>

            </div>

        <% } %>

</section>


<!-- =========================
     PROFILE IMAGE PREVIEW
========================== -->

<script>

    function previewProfileImage(event) {

        const file = event.target.files[0];

        if (!file) return;

        const preview = document.getElementById("profilePreview");

        preview.src = URL.createObjectURL(file);

    }

</script>




        

    </main>

</body>

</html>
