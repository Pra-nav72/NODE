<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>

    <title><%= blog.title %> | Blog</title>
</head>

<body class="bg-slate-950 text-white">

    <%- include('./partials/Navigation') %>


    <!-- Blog Container -->
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Back Button -->
        <div class="mb-8">

            <a
                href="/"
                class="inline-flex items-center gap-2
                       text-sm font-semibold
                       text-slate-400
                       hover:text-cyan-400
                       transition-colors"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"
                    />
                </svg>

                Back to blogs

            </a>

        </div>


        <!-- Blog Article -->
        <article
            class="overflow-hidden
                   rounded-3xl
                   bg-slate-900
                   border border-slate-800
                   shadow-2xl"
        >

            <!-- Cover Image -->
            <div class="relative w-full h-64 sm:h-80 md:h-105 overflow-hidden">

                <img
                    src="<%= blog.coverImageURL %>"
                    alt="<%= blog.title %>"
                    class="w-full h-full object-cover"
                >

                <!-- Image Overlay -->
                <div
                    class="absolute inset-0
                           bg-linear-to-t
                           from-slate-950
                           via-slate-950/30
                           to-transparent"
                ></div>

                <!-- Title on Image -->
                <div
                    class="absolute bottom-0 left-0 right-0
                           p-6 sm:p-8 md:p-10"
                >

                    <h1
                        class="text-3xl sm:text-4xl md:text-5xl
                               font-bold
                               leading-tight
                               text-white"
                    >
                        <%= blog.title %>
                    </h1>

                </div>

            </div>


            <!-- Article Content -->
            <div class="p-6 sm:p-8 md:p-10">

                <!-- Author Information -->
                <div
                    class="flex flex-wrap items-center
                           justify-between
                           gap-4
                           pb-6
                           mb-8
                           border-b border-slate-800"
                >

                    <!-- Author -->
                    <div class="flex items-center gap-3">

                        <img
                            src="<%= blog.createdBy.profileImageURL %>"
                            alt="<%= blog.createdBy.username %>"
                            class="w-12 h-12
                                   rounded-full
                                   object-cover
                                   border-2
                                   border-cyan-400"
                        >

                        <div>

                            <p class="font-semibold text-white">
                                <%= blog.createdBy.username %>
                            </p>

                            <p class="text-sm text-slate-500">
                                Published on
                                <%= new Date(blog.createdAt).toLocaleDateString('en-US', {
                                    year: 'numeric',
                                    month: 'long',
                                    day: 'numeric'
                                }) %>
                            </p>

                        </div>

                    </div>


                    <!-- Reading Label -->
                    <div
                        class="px-4 py-2
                               rounded-full
                               bg-cyan-500/10
                               border border-cyan-500/20
                               text-sm
                               text-cyan-400"
                    >
                        Blog
                    </div>

                </div>


                <!-- Blog Body -->
                <div
                    class="prose
                           prose-invert
                           prose-lg
                           max-w-none
                           text-slate-300
                           leading-8"
                >

                    <%= blog.body %>

                </div>


                <!-- Bottom Divider -->
                <div class="mt-12 pt-8 border-t border-slate-800">

                    <div class="flex flex-col sm:flex-row
                                items-center
                                justify-between
                                gap-4">

                        <p class="text-sm text-slate-500">
                            Thanks for reading!
                        </p>


                        <a
                            href="/"
                            class="inline-flex
                                   items-center
                                   gap-2
                                   px-5 py-2.5
                                   rounded-xl
                                   bg-linear-to-r
                                   from-cyan-500
                                   to-blue-600
                                   text-white
                                   font-semibold
                                   hover:from-cyan-400
                                   hover:to-blue-500
                                   transition-all"
                        >

                            Explore more blogs

                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                                />
                            </svg>

                        </a>

                    </div>

                </div>

            </div>

        </article>

    </main>

</body>

</html>